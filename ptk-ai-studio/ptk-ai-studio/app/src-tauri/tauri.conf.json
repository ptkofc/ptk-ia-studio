{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTK AI STUDIO", "version": "0.1.0", "identifier": "com.ptk.aistudio",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420",
             "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "PTK AI STUDIO", "width": 1280, "height": 800, "minWidth": 1000, "minHeight": 650 }],
           "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"],
              "externalBin": ["binaries/ptk-engine"], "resources": ["resources/ffmpeg/*"],
              "windows": { "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"] } } }
}
